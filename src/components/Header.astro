---
import { church, nav, displayName, img } from '../lib/church';
const path = Astro.url.pathname.replace(/\/?$/, '/');
const visit = nav.find((n) => n.href === '/visit/');
const links = nav.filter((n) => n !== visit);
---
<header class="site-header">
  <div class="container">
    <a class="brand" href="/">
      {church.logo && <img src={img(church.logo)} alt="" width="44" height="44" />}
      <span>{displayName}</span>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav class="nav" id="site-nav" aria-label="Main">
      {links.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
      {visit && <a class="btn" href={visit.href}>{visit.label}</a>}
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
